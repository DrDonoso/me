---
import { siteConfig } from "../config";
import SocialLinks from "./SocialLinks.astro";
---

<div
  id="hero"
  class="relative isolate overflow-hidden bg-white dark:bg-[#131C2E] dark:bg-[#0B1120] py-24 md:h-screen"
>
  <!-- Gradient overlay -->
  <div class="absolute inset-0 -z-10 hero-gradient"></div>
  <svg
    aria-hidden="true"
    class="absolute inset-0 -z-10 size-full stroke-gray-200 [mask-image:radial-gradient(100%_100%_at_top_right,white,transparent)]"
  >
    <defs>
      <pattern
        x="50%"
        y={-1}
        id="0787a7c5-978c-4f66-83c7-11c213f99cb7"
        width={200}
        height={200}
        patternUnits="userSpaceOnUse"
      >
        <path d="M.5 200V.5H200" fill="none"></path>
      </pattern>
      <pattern
        id="programming-symbols"
        x="0"
        y="0"
        width="400"
        height="400"
        patternUnits="userSpaceOnUse"
      >
        <text
          x="50"
          y="50"
          class="accent-fill"
          font-family="monospace"
          font-size="24"
          transform="rotate(-15)">&lt;/&gt;</text
        >
        <text
          x="150"
          y="100"
          class="accent-fill"
          font-family="monospace"
          font-size="20"
          transform="rotate(10)">{}</text
        >
        <text
          x="250"
          y="80"
          class="accent-fill"
          font-family="monospace"
          font-size="18"
          transform="rotate(-5)">=&gt;</text
        >
        <text
          x="100"
          y="200"
          class="accent-fill"
          font-family="monospace"
          font-size="22"
          transform="rotate(15)">[]</text
        >
        <text
          x="300"
          y="180"
          class="accent-fill"
          font-family="monospace"
          font-size="20"
          transform="rotate(-10)">&lt;&gt;</text
        >
        <text
          x="200"
          y="250"
          class="accent-fill"
          font-family="monospace"
          font-size="24"
          transform="rotate(5)">()</text
        >
        <text
          x="50"
          y="320"
          class="accent-fill"
          font-family="monospace"
          font-size="18"
          transform="rotate(-8)">::</text
        >
        <text
          x="350"
          y="300"
          class="accent-fill"
          font-family="monospace"
          font-size="22"
          transform="rotate(12)">==</text
        >
        <text
          x="150"
          y="350"
          class="accent-fill"
          font-family="monospace"
          font-size="20"
          transform="rotate(-15)">++</text
        >
        <text
          x="250"
          y="370"
          class="accent-fill"
          font-family="monospace"
          font-size="24"
          transform="rotate(8)">;</text
        >
      </pattern>
    </defs>
    <rect
      fill="url(#programming-symbols)"
      width="100%"
      height="100%"
      opacity="0.2"></rect>
    <rect
      fill="url(#0787a7c5-978c-4f66-83c7-11c213f99cb7)"
      width="100%"
      height="100%"
      stroke-width={0}></rect>
  </svg>
  <div class="h-full mx-auto p-8 sm:p-12 md:p-24 flex items-center">
    <div class="flex flex-col-reverse md:flex-row md:items-center gap-8 md:gap-12 lg:gap-16">
      <div>
        <h2
          class="text-pretty text-xl sm:text-2xl md:text-5xl font-bold tracking-tight text-gray-700 dark:text-gray-300 animate-fade-in"
        >
          Hello! 👋
        </h2>
        <h1
          class="mt-6 sm:mt-8 md:mt-10 text-pretty text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold tracking-tight text-gray-800 dark:text-gray-100 animate-fade-in animation-delay-200"
        >
          I'm <span class="accent-text">{siteConfig.name}</span>
        </h1>
        <p
          class="mt-4 sm:mt-6 md:mt-8 text-pretty text-base sm:text-lg md:text-xl/8 font-medium text-gray-600 dark:text-gray-400 animate-fade-in animation-delay-400"
        >
          {siteConfig.title}
          {
            siteConfig.company && (
              <>
                {" at "}
                <a
                  href={siteConfig.companyUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="accent-text font-semibold underline decoration-transparent hover:decoration-current underline-offset-4 transition-colors duration-300"
                >
                  {siteConfig.company}
                </a>
              </>
            )
        }
      </p>
      </div>

      {
        siteConfig.photo && (
          <div class="shrink-0 animate-fade-in animation-delay-200">
            <picture>
              <source srcset={siteConfig.photo} type="image/webp" />
              <img
                src={siteConfig.photoFallback ?? siteConfig.photo}
                alt={siteConfig.name}
                width="460"
                height="460"
                loading="eager"
                fetchpriority="high"
                decoding="async"
                class="w-32 h-32 sm:w-40 sm:h-40 md:w-56 md:h-56 lg:w-64 lg:h-64 rounded-full object-cover shadow-xl ring-4 ring-white/70 dark:ring-white/10"
              />
            </picture>
          </div>
        )
      }
    </div>
  </div>
  <SocialLinks
    containerClass="absolute bottom-0 left-0 right-0 p-8 sm:p-12 md:p-24 flex flex-wrap gap-x-4 gap-y-3 sm:gap-x-6 md:gap-x-8 text-gray-700 dark:text-gray-300 animate-fade-in animation-delay-600"
    iconClass="h-6 w-6 sm:h-7 sm:w-7 md:h-8 md:w-8"
  />
</div>

<style>
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in {
    animation: fadeIn 0.8s ease-out forwards;
    opacity: 0;
  }

  .animation-delay-200 {
    animation-delay: 0.2s;
  }

  .animation-delay-400 {
    animation-delay: 0.4s;
  }

  .animation-delay-600 {
    animation-delay: 0.6s;
  }
</style>
