---
import { siteConfig } from "../config";
const hasCertifications =
  siteConfig.certifications && siteConfig.certifications.length > 0;
---

{
  hasCertifications && (
    <section id="certifications" class="p-8 sm:p-12 md:p-16 lg:p-24">
      <div>
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
          <div class="lg:col-span-4">
            <h2 class="text-3xl sm:text-4xl md:text-5xl xl:text-7xl font-bold text-gray-900 dark:text-gray-100">
              Certifications
            </h2>
            <div
              class="w-[75px] h-[5px] mt-2 rounded-full accent-bg"
            />
            {siteConfig.certificationsUrl && (
              <a
                href={siteConfig.certificationsUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 mt-6 text-sm sm:text-base font-semibold underline decoration-transparent hover:decoration-current underline-offset-4 transition-colors duration-300 accent-text"
              >
                Verify on Credly
                <svg
                  class="w-4 h-4"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M7 17L17 7M17 7H7M17 7V17"
                  />
                </svg>
              </a>
            )}
          </div>

          <div class="lg:col-span-8">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              {siteConfig.certifications.map((cert) => (
                <div class="bg-white dark:bg-[#131C2E] rounded-lg shadow-sm border border-gray-100 dark:border-gray-800 p-4 sm:p-5 hover:shadow-md transition-shadow duration-300 flex flex-col">
                  <div class="flex items-start justify-between gap-3">
                    <h3 class="text-base sm:text-lg font-semibold text-gray-900 dark:text-gray-100 leading-snug">
                      {cert.name}
                    </h3>
                    {cert.code && (
                      <span
                        class="shrink-0 text-xs font-mono font-semibold px-2 py-1 rounded-full bg-gray-100 dark:bg-gray-800 accent-text"
                      >
                        {cert.code}
                      </span>
                    )}
                  </div>
                  <div class="mt-auto pt-3 flex items-center justify-between text-xs sm:text-sm">
                    <span
                      class="font-medium accent-text"
                    >
                      {cert.issuer}
                    </span>
                    <span class="text-gray-500 dark:text-gray-500">{cert.date}</span>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>
  )
}
