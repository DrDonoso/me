---
import { siteConfig } from "../config";
import SocialLinks from "./SocialLinks.astro";

const contact = siteConfig.contact;
const email = siteConfig.social?.email;
---

{
  contact && email && (
    <section
      id="contact"
      class="p-8 sm:p-12 md:p-16 lg:p-24 border-t border-gray-100 dark:border-gray-800"
    >
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
        <div class="lg:col-span-4">
          <h2 class="text-3xl sm:text-4xl md:text-5xl xl:text-7xl font-bold text-gray-900 dark:text-gray-100">
            {contact.heading}
          </h2>
          <div class="w-[75px] h-[5px] mt-2 rounded-full accent-bg" />
        </div>

        <div class="lg:col-span-8">
          <p class="text-lg sm:text-xl md:text-2xl leading-relaxed text-gray-600 dark:text-gray-400">
            {contact.text}
          </p>

          <a
            href={`mailto:${email}`}
            class="accent-btn inline-flex items-center gap-3 mt-8 px-6 py-3.5 rounded-full font-semibold text-base sm:text-lg shadow-sm hover:shadow-lg hover:-translate-y-0.5 transition-all duration-300 break-all"
          >
            <svg
              class="w-5 h-5 shrink-0"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10z" />
              <path d="M3 7l9 6l9 -6" />
            </svg>
            {email}
          </a>

          {contact.location && (
            <p class="mt-6 flex items-center gap-2 text-sm sm:text-base text-gray-500 dark:text-gray-500">
              <svg
                class="w-4 h-4 shrink-0"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M9 11a3 3 0 1 0 6 0a3 3 0 0 0 -6 0" />
                <path d="M17.657 16.657l-4.243 4.243a2 2 0 0 1 -2.827 0l-4.244 -4.243a8 8 0 1 1 11.314 0z" />
              </svg>
              {contact.location}
            </p>
          )}

          <div class="mt-10">
            <p class="text-xs sm:text-sm font-semibold uppercase tracking-widest text-gray-500 dark:text-gray-500 mb-4">
              Elsewhere
            </p>
            <SocialLinks
              containerClass="flex flex-wrap gap-x-6 gap-y-3 text-gray-700 dark:text-gray-300"
              iconClass="h-7 w-7"
            />
          </div>
        </div>
      </div>
    </section>
  )
}
