---
import { siteConfig } from "../config";
import "../styles/global.css";
---

<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content={siteConfig.accentColor} />
    <title>Page not found - {siteConfig.name}</title>
        <script is:inline>
      (() => {
        const stored = localStorage.getItem("theme");
        const dark = stored === "dark" || (!stored && window.matchMedia("(prefers-color-scheme: dark)").matches);
        document.documentElement.classList.toggle("dark", dark);
      })();
    </script>
    <style is:global set:html={`
      :root { --accent: ${siteConfig.accentColor}; --accent-text: ${siteConfig.accentTextColor}; --page-bg: #ffffff; }
      .dark { --accent: ${siteConfig.dark.accentColor}; --accent-text: ${siteConfig.dark.accentTextColor}; --page-bg: #0B1120; }
    `} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <main
      class="relative isolate min-h-screen flex items-center overflow-hidden bg-white dark:bg-[#0B1120]"
    >
      <div class="absolute inset-0 -z-10 hero-gradient"></div>

      <div class="p-8 sm:p-12 md:p-24">
        <p
          class="text-xl sm:text-2xl md:text-5xl font-bold tracking-tight accent-text"
        >
          404
        </p>
        <h1
          class="mt-6 sm:mt-8 text-pretty text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold tracking-tight text-gray-800 dark:text-gray-100"
        >
          Page not found
        </h1>
        <p
          class="mt-4 sm:mt-6 text-pretty text-base sm:text-lg md:text-xl/8 font-medium text-gray-600 dark:text-gray-400"
        >
          That page doesn't exist — or it moved somewhere else.
        </p>
        <a
          href="/"
          class="inline-flex items-center gap-2 mt-8 px-5 py-2.5 rounded-full text-white font-semibold text-sm sm:text-base shadow-sm hover:shadow-lg hover:-translate-y-0.5 transition-all duration-300 accent-btn"
        >
          <svg
            class="w-4 h-4"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M10 19l-7-7m0 0l7-7m-7 7h18"
            />
          </svg>
          Back home
        </a>
      </div>
    </main>
  </body>
</html>
