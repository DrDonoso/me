---
import { siteConfig } from "../config";
import "../styles/global.css";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content={siteConfig.accentColor} />
    <title>Page not found - {siteConfig.name}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <main
      class="relative isolate min-h-screen flex items-center overflow-hidden bg-white"
    >
      <div
        class="absolute inset-0 -z-10"
        style={`background: radial-gradient(ellipse 800px 1200px at 0% 0%, ${siteConfig.accentColor}40 0%, ${siteConfig.accentColor}25 20%, ${siteConfig.accentColor}10 40%, rgba(255, 255, 255, 0.3) 70%, rgba(255, 255, 255, 0.8) 90%, white 100%)`}
      >
      </div>

      <div class="p-8 sm:p-12 md:p-24">
        <p
          class="text-xl sm:text-2xl md:text-5xl font-bold tracking-tight"
          style={`color: ${siteConfig.accentTextColor}`}
        >
          404
        </p>
        <h1
          class="mt-6 sm:mt-8 text-pretty text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold tracking-tight text-gray-800"
        >
          Page not found
        </h1>
        <p
          class="mt-4 sm:mt-6 text-pretty text-base sm:text-lg md:text-xl/8 font-medium text-gray-600"
        >
          That page doesn't exist — or it moved somewhere else.
        </p>
        <a
          href="/"
          class="inline-flex items-center gap-2 mt-8 px-5 py-2.5 rounded-full text-white font-semibold text-sm sm:text-base shadow-sm hover:shadow-lg hover:-translate-y-0.5 transition-all duration-300"
          style={`background-color: ${siteConfig.accentTextColor}`}
        >
          <svg
            class="w-4 h-4"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M10 19l-7-7m0 0l7-7m-7 7h18"
            />
          </svg>
          Back home
        </a>
      </div>
    </main>
  </body>
</html>
